{
  "id": "markdown-linting",
  "role": "feature",
  "version": "0.3.1",
  "title": "Markdown linting",
  "description": "Wraps rumdl over .planning/, README.md, and CLAUDE.md; verify:post writes a gate-readable violation-count report, ship:pre re-measures and advises (never blocks).",
  "tier": "full",
  "requires": [],
  "engines": {
    "gsd": ">=1.6.0"
  },
  "runtimeCompat": {
    "supported": [
      "*"
    ],
    "unsupported": []
  },
  "skills": [
    "markdown-linting-report"
  ],
  "agents": [],
  "hooks": [],
  "config": {
    "markdown-linting.enabled": {
      "type": "boolean",
      "default": true,
      "description": "Master toggle for the markdown-linting capability."
    },
    "markdown-linting.ship_gate": {
      "type": "boolean",
      "default": true,
      "description": "When true, ship:pre advises (never blocks) when lint.py count re-measures a nonzero violation count."
    }
  },
  "steps": [
    {
      "point": "verify:post",
      "ref": {
        "skill": "markdown-linting-report"
      },
      "produces": [
        "LINT-REPORT.md"
      ],
      "consumes": [],
      "when": "markdown-linting.enabled",
      "onError": "skip"
    }
  ],
  "contributions": [],
  "gates": [
    {
      "point": "ship:pre",
      "check": {
        "predicate": {
          "kind": "command-exit-zero",
          "timeout": 90,
          "command": "L=\"${CLAUDE_PROJECT_DIR:-.}/.gsd/capabilities/markdown-linting/scripts/lint.py\"; [ -f \"$L\" ] || L=\"${GSD_HOME:-$HOME}/.gsd/capabilities/markdown-linting/scripts/lint.py\"; [ \"$(python3 \"$L\" count)\" = 0 ]"
        }
      },
      "when": "markdown-linting.ship_gate",
      "blocking": false,
      "onError": "skip",
      "description": "Advisory: runs lint.py count at ship:pre; a nonzero count warns but never blocks."
    }
  ]
}
